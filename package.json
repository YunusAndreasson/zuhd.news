{
  "name": "zuhd-news",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "News for all humans. Typography-first, minimalist news site.",
  "scripts": {
    "dev": "SKIP_OG=1 node scripts/watch.js",
    "dev:once": "SKIP_OG=1 node scripts/publish-edition.js --preview && npx wrangler pages dev dist",
    "dev:og": "node scripts/publish-edition.js --preview && npx wrangler pages dev dist",
    "build": "node scripts/publish-edition.js",
    "test": "node --test scripts/lib/*.test.js",
    "test:unit": "node --test $(ls scripts/lib/*.test.js | grep -vE 'lib/(logs|corpus|selection|blocks|share-card-type)\\.test\\.js$')",
    "test:cycle": "node --test scripts/cycle/golden.test.js",
    "test:live": "node --test scripts/lib/logs.test.js scripts/lib/corpus.test.js scripts/lib/selection.test.js scripts/lib/blocks.test.js scripts/lib/share-card-type.test.js",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "deadcode": "knip --include files,dependencies,exports --no-config-hints",
    "deadcode:css": "node scripts/perf/css-usage.mjs",
    "typecheck": "tsc -p tsconfig.islands.json && tsc -p tsconfig.node.json && tsc -p tsconfig.pipeline.json",
    "verify": "npm run lint && npm run typecheck && npm test",
    "perf": "node scripts/perf/probe.mjs",
    "perf:idle": "node scripts/perf/idle-renders.mjs",
    "perf:profile": "node scripts/perf/idle-profile.mjs",
    "fetch": "node scripts/fetch-news.js",
    "deploy": "npx wrangler pages deploy dist --project-name zuhd-news --branch master --commit-dirty=true",
    "publish": "node scripts/publish-edition.js && npm run deploy",
    "briefing": "node scripts/generate-briefing.js"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^7.2.0",
    "@maplibre/geojson-vt": "^7.0.1",
    "@maplibre/vt-pbf": "^4.3.3",
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "d3-geo": "^3.1.2",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.12.1",
    "htm": "^3.1.1",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^5.5.0",
    "jsdom": "^31.0.1",
    "maplibre-gl": "^6.19.0",
    "nodemailer": "^10.6.1",
    "preact": "^11.2.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@mapbox/tiny-sdf": "^2.3.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/maplibre-gl-style-spec": "^26.9.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "adhan": "^4.4.6",
    "astronomy-engine": "^2.1.19",
    "knip": "^6.48.0",
    "pbf": "^5.2.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2"
  }
}
