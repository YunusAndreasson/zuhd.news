{
  "name": "zuhd-news",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "News for all humans. Typography-first, minimalist news site.",
  "scripts": {
    "dev": "node scripts/build.js && npx wrangler pages dev dist",
    "build": "node scripts/build.js",
    "fetch": "node scripts/fetch-news.js",
    "deploy": "npx wrangler pages deploy dist --project-name zuhd-news --branch master --commit-dirty=true",
    "publish": "node scripts/build.js && npm run deploy",
    "briefing": "node scripts/generate-briefing.js",
    "briefing:voice": "node scripts/test-voice.js"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.0.0",
    "d3-geo": "^3.1.1",
    "fast-xml-parser": "^5.2.0",
    "js-yaml": "^4.1.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5"
  }
}
