{
  "name": "zuhd-news",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "News for all humans. Typography-first, minimalist news site.",
  "scripts": {
    "dev": "SKIP_OG=1 node scripts/watch.js",
    "dev:once": "SKIP_OG=1 node scripts/build.js && npx wrangler pages dev dist",
    "dev:og": "node scripts/build.js && npx wrangler pages dev dist",
    "build": "node scripts/build.js",
    "test": "node --test scripts/lib/*.test.js",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "deadcode": "knip --include files,dependencies --no-config-hints",
    "typecheck": "tsc -p tsconfig.islands.json && tsc -p tsconfig.node.json",
    "verify": "npm run lint && npm run typecheck && npm test",
    "perf": "node scripts/perf/probe.mjs",
    "perf:idle": "node scripts/perf/idle-renders.mjs",
    "perf:profile": "node scripts/perf/idle-profile.mjs",
    "fetch": "node scripts/fetch-news.js",
    "deploy": "npx wrangler pages deploy dist --project-name zuhd-news --branch master --commit-dirty=true",
    "publish": "node scripts/build.js && npm run deploy",
    "briefing": "node scripts/generate-briefing.js",
    "briefing:voice": "node scripts/test-voice.js"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.1",
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.0",
    "fast-xml-parser": "^5.8.0",
    "htm": "^3.1.1",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^5.2.3",
    "jsdom": "^29.1.1",
    "maplibre-gl": "^6.1.0",
    "preact": "^10.29.8",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "adhan": "^4.4.4",
    "astronomy-engine": "^2.1.19",
    "knip": "^6.31.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
