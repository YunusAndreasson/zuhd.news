+// Save the OS observation made while the launcher owns the screen.
+@Synchronized
+internal fun observeBriefingWidgets(context: Context): Map<String, Any> {
+  val manager = android.appwidget.AppWidgetManager.getInstance(context)
+  val component = widgetProviderComponentName(context, "DailyBriefing")
+  val present = manager.getAppWidgetIds(component).any {
+    val bound = manager.getAppWidgetInfo(it)?.provider
+    bound == null || bound == component
+  }
+  val store = context.getSharedPreferences("DailyBriefingPlacement", Context.MODE_PRIVATE)
+  val history = org.json.JSONArray(store.getString("history", "[]"))
+  if (history.length() == 0 || store.getBoolean("home", false) != present) {
+    val sequence = store.getLong("sequence", 0) + 1
+    val time = System.currentTimeMillis()
+    history.put(org.json.JSONObject().put("home", present).put("observed", time).put("sequence", sequence))
+    if (history.length() > 32) history.remove(0)
+    store.edit().putBoolean("home", present).putLong("sequence", sequence)
+      .putString("history", history.toString()).apply()
+  }
+  val observations = (0 until history.length()).map {
+    val row = history.getJSONObject(it)
+    mapOf("home" to row.getBoolean("home"), "accessory" to false,
+      "observed" to row.getLong("observed").toDouble(), "sequence" to row.getLong("sequence").toDouble())
+  }
+  return observations.last() + ("history" to observations)
+}
