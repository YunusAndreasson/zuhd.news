+package expo.modules.widgets
+
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.appwidget.AppWidgetManager
+import android.content.BroadcastReceiver
+import android.content.ComponentCallbacks
+import android.content.res.Configuration
+import android.content.Context
+import android.content.Intent
+import android.net.ConnectivityManager
+import android.net.NetworkCapabilities
+
+internal object WidgetClock {
+  private var watching = false
+
+  @Synchronized
+  fun watch(context: Context) {
+    if (watching) return
+    watching = true
+    val app = context.applicationContext
+    app.registerComponentCallbacks(object : ComponentCallbacks {
+      override fun onConfigurationChanged(newConfig: Configuration) {
+        WidgetsUpdater.reloadAll(app)
+      }
+
+      override fun onLowMemory() = Unit
+    })
+    runCatching {
+      app.getSystemService(ConnectivityManager::class.java)?.registerDefaultNetworkCallback(
+        object : ConnectivityManager.NetworkCallback() {
+          override fun onAvailable(network: android.net.Network) { WidgetsUpdater.reloadAll(app) }
+          override fun onLost(network: android.net.Network) { WidgetsUpdater.reloadAll(app) }
+        }
+      )
+    }
+  }
+
+  private data class Entry(val timestamp: Long, val face: Map<String, Any?>, val offlineFace: Map<String, Any?>)
+
+  private fun entries(props: Map<String, Any?>?): List<Entry> {
+    val values = props?.get("timeline") as? List<*> ?: return emptyList()
+    return values.mapNotNull { value ->
+      val row = value as? Map<*, *> ?: return@mapNotNull null
+      val timestamp = (row["timestamp"] as? Number)?.toLong() ?: return@mapNotNull null
+      val face = row["face"] as? Map<*, *> ?: return@mapNotNull null
+      val offlineFace = row["offlineFace"] as? Map<*, *> ?: face
+      return@mapNotNull Entry(
+        timestamp,
+        face.entries.associate { it.key.toString() to it.value },
+        offlineFace.entries.associate { it.key.toString() to it.value }
+      )
+    }
+  }
+
+  fun briefingFace(props: Map<String, Any?>?, now: Long, offline: Boolean): Map<String, Any?>? {
+    if (props?.containsKey("timeline") != true) return props
+    val entry = entries(props).lastOrNull { it.timestamp <= now } ?: return emptyMap()
+    return if (offline) entry.offlineFace else entry.face
+  }
+
+  fun schedule(context: Context) {
+    val alarm = context.getSystemService(AlarmManager::class.java) ?: return
+    val component = widgetProviderComponentName(context, "DailyBriefing")
+    val hasBriefing = AppWidgetManager.getInstance(context).getAppWidgetIds(component).isNotEmpty()
+    val pending = PendingIntent.getBroadcast(
+      context,
+      0,
+      Intent(context, WidgetClockReceiver::class.java),
+      PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
+    )
+    val props = WidgetsLayoutRegistry.props(context, "DailyBriefing")
+    val now = System.currentTimeMillis()
+    val next = if (hasBriefing) entries(props).firstOrNull { it.timestamp > now }?.timestamp else null
+    if (next == null) alarm.cancel(pending)
+    else alarm.setAndAllowWhileIdle(AlarmManager.RTC, next, pending)
+  }
+
+  fun offline(context: Context): Boolean? = runCatching {
+    val connectivity = context.getSystemService(ConnectivityManager::class.java)
+      ?: return@runCatching null
+    val active = connectivity.activeNetwork ?: return@runCatching true
+    val capabilities = connectivity.getNetworkCapabilities(active) ?: return@runCatching null
+    !capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+  }.getOrNull()
+}
+
+class WidgetClockReceiver : BroadcastReceiver() {
+  override fun onReceive(context: Context, intent: Intent) {
+    val result = goAsync()
+    WidgetClock.schedule(context)
+    WidgetsUpdater.reloadAll(context) { result.finish() }
+  }
+}
