+internal object NewsWidgetConfiguration {
+  private fun store(context: Context) =
+    context.getSharedPreferences("LatestNewsConfiguration", Context.MODE_PRIVATE)
+
+  fun get(context: Context, id: Int): Map<String, Any?> =
+    store(context).getString(id.toString(), null)?.let {
+      runCatching { WidgetsJson.parseMap(it) }.getOrNull()
+    } ?: emptyMap()
+
+  fun save(context: Context, id: Int, choices: Map<String, Any>): Boolean =
+    store(context).edit().putString(id.toString(), WidgetsJson.stringifyMap(choices)).commit()
+
+  fun remove(context: Context, ids: IntArray) {
+    val edit = store(context).edit()
+    ids.forEach { edit.remove(it.toString()) }
+    edit.apply()
+  }
+
+  fun restore(context: Context, oldIds: IntArray, newIds: IntArray) {
+    val preferences = store(context)
+    val previous = oldIds.map { preferences.getString(it.toString(), null) }
+    val edit = preferences.edit()
+    oldIds.forEach { edit.remove(it.toString()) }
+    newIds.forEachIndexed { index, id -> edit.putString(id.toString(), previous.getOrNull(index)) }
+    edit.apply()
+  }
+}
