{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "development:simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "SENTRY_ORG": "openarabic",
        "SENTRY_PROJECT": "zuhd",
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "node": "26.12.0",
      "env": {
        "SENTRY_ORG": "openarabic",
        "SENTRY_PROJECT": "zuhd",
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "ios": {
        "image": "auto"
      },
      "android": {
        "image": "auto",
        // The default worker's Gradle daemon was killed (out of memory) on
        // 1448.6.4, 2026-11-15; qamar360 and edenmind build on large too.
        "resourceClass": "large"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "jonas@lightgate-imagery.com",
        "ascAppId": "6760964753",
        "appleTeamId": "G9UUQ9MDS4"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
