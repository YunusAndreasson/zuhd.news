<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="16dp"
  android:background="?android:attr/colorBackground">
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="@font/widget_source_sans_bold"
    android:paddingBottom="8dp"
    android:text="zuhd.news"
    android:textColor="?android:attr/textColorPrimary"
    android:textSize="16sp" />
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="@font/widget_source_sans_bold"
    android:text="@string/latest_news_display_name"
    android:textColor="?android:attr/textColorPrimary"
    android:textSize="19sp" />
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="@font/widget_source_sans_regular"
    android:text="@string/latest_news_description"
    android:textColor="?android:attr/textColorSecondary"
    android:textSize="14sp" />
</LinearLayout>
