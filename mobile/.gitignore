# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# dry-run augmented brief (generated by scripts/dry-run-augment.js)
lib/dev-context-demo.json

# credentials
google-service-account.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# argent — per-machine MCP / editor configs generated by `argent init|update`.
# These embed absolute paths (e.g. ~/.argent/mcp-calls.log) and editor choices
# specific to whoever ran the init; teammates regenerate their own.
.mcp.json
.codex/
.opencode/
.zed/
opencode.json

# argent — local bug-hunt log
BUGS.md

# shared/ — populated by scripts/eas-fetch-shared.js on EAS Build.
# Locally, `@shared/*` resolves to ../shared/ via metro.config + tsconfig;
# this in-project copy only exists on the EAS build server.
/shared

