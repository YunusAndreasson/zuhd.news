{
  "name": "mobile",
  "version": "1448.4.6+289",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "./scripts/dev-android.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "deps:check": "bash ./scripts/update-deps.sh",
    "api:check": "node ./scripts/check-deprecated-apis.mjs",
    "deps:update": "bash ./scripts/update-deps.sh --apply",
    "deps:update:latest": "bash ./scripts/update-deps.sh --apply --latest",
    "verify": "npm run typecheck && npm run lint && npm run api:check && npm run test",
    "bump": "node scripts/bump.js",
    "icons": "node scripts/generate-icons.mjs",
    "test": "jest",
    "bench": "tsx perf/run-bench.ts",
    "bench:update": "tsx perf/run-bench.ts --update-baseline",
    "bundle:check": "./scripts/check-bundle-size.sh",
    "release": "./scripts/release.sh all",
    "release:check": "./scripts/release.sh --check all",
    "release:ios": "./scripts/release.sh ios",
    "release:android": "./scripts/release.sh android",
    "release:all": "./scripts/release.sh all",
    "postinstall": "patch-package --error-on-fail && node ./scripts/setup-shared-link.js",
    "eas-build-pre-install": "node ./scripts/eas-fetch-shared.js"
  },
  "dependencies": {
    "@expo-google-fonts/material-symbols": "^0.4.50",
    "@expo/ui": "~58.0.20",
    "@tanstack/query-async-storage-persister": "^5.104.3",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-persist-client": "^5.104.3",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time-format": "^4.1.0",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-background-task": "~58.0.11",
    "expo-blur": "~58.0.4",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-store-review": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.17",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-skia": "3.6.2",
    "react-native-worklets": "0.13.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@expo/agent-cli": "^1.0.19",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time-format": "^4.0.3",
    "@types/jest": "30.0.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "~19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "babel-jest": "~30.5.2",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "patch-package": "^8.0.1",
    "react-dom": "19.3.0",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "optionalDependencies": {
    "opentype.js": "^1.3.4",
    "sharp": "^0.34.5"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-ui"
        ]
      }
    }
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "\\.[jt]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(d3-[^/]+|internmap|expo/virtual)/)"
    ],
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../shared/$1",
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1"
    },
    "globalSetup": "./jest.global-setup.js",
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "private": true
}
