{
  "name": "mobile",
  "version": "1448.2.17+287",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "./scripts/dev-android.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "deps:check": "bash ./scripts/update-deps.sh",
    "deps:update": "bash ./scripts/update-deps.sh --apply",
    "deps:update:latest": "bash ./scripts/update-deps.sh --apply --latest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "bump": "node scripts/bump.js",
    "icons": "node scripts/generate-icons.mjs",
    "test": "jest",
    "bench": "tsx perf/run-bench.ts",
    "bench:update": "tsx perf/run-bench.ts --update-baseline",
    "bundle:check": "./scripts/check-bundle-size.sh",
    "release": "./scripts/release.sh all",
    "release:check": "./scripts/release.sh --check all",
    "release:ios": "./scripts/release.sh ios",
    "release:android": "./scripts/release.sh android",
    "release:all": "./scripts/release.sh all",
    "postinstall": "node ./scripts/setup-shared-link.js",
    "eas-build-pre-install": "node ./scripts/eas-fetch-shared.js"
  },
  "dependencies": {
    "@expo/ui": "~57.0.8",
    "@expo/vector-icons": "^15.1.1",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time-format": "^4.1.0",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-background-task": "~57.0.6",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-file-system": "57.0.1",
    "expo-font": "57.0.1",
    "expo-haptics": "57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-navigation-bar": "~57.0.2",
    "expo-network": "57.0.1",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-secure-store": "57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.6",
    "expo-updates": "~57.0.10",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.0",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/d3-time-format": "^4.0.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.17",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "react-dom": "19.2.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "optionalDependencies": {
    "opentype.js": "^1.3.4",
    "sharp": "^0.34.5"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler"
      ]
    }
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "\\.[jt]sx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../shared/$1"
    },
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "private": true
}
