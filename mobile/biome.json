{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "assist": {
    "actions": {
      "source": { "organizeImports": "on" }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "test": "recommended"
    },
    "rules": {
      "recommended": true,
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "warn",
        "noImplicitAnyLet": "error",
        "noExplicitAny": "error",
        "noEvolvingTypes": "error",
        "useAwait": "warn",
        "noSkippedTests": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      }
    }
  },
  "files": {
    "includes": [
      "app/**",
      "components/**",
      "constants/**",
      "hooks/**",
      "lib/**",
      "scripts/**",
      "perf/**",
      "__tests__/**"
    ]
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "assist": {
        "actions": {
          "source": { "organizeImports": "off" }
        }
      },
      "linter": {
        "rules": {
          "suspicious": {
            "useAwait": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
