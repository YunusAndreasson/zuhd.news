{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": false,
  "assist": {
    "actions": {
      "source": { "organizeImports": "on" }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "warn",
        "noImplicitAnyLet": "error",
        "noExplicitAny": "error",
        "noEvolvingTypes": "error",
        "useAwait": "warn",
        "noSkippedTests": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      }
    }
  },
  "files": {
    "includes": [
      "app/**",
      "components/**",
      "constants/**",
      "hooks/**",
      "lib/**",
      "scripts/**",
      "perf/**",
      "__tests__/**",
      "!**/*.md"
    ]
  },
  "overrides": [
    {
      "includes": [
        "app/**",
        "components/**",
        "constants/**",
        "hooks/**",
        "lib/**",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "plugins": ["./biome-plugins/hermes-v1-using.grit", "./biome-plugins/hermes-v1-properties.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "DisposableStack": "Missing from the Hermes v1 VM RN 0.88 ships (typechecks and passes jest, crashes on device). Use try/finally.",
                  "AsyncDisposableStack": "Missing from the Hermes v1 VM RN 0.88 ships (typechecks and passes jest, crashes on device). Use try/finally."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "assist": {
        "actions": {
          "source": { "organizeImports": "off" }
        }
      },
      "linter": {
        "rules": {
          "suspicious": {
            "useAwait": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
