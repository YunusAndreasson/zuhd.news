// Unreferenced files, exports and dependencies across the web surface.
//
// Biome catches an unused variable inside a file. Nothing caught an unused
// *file* — which is how five scripts totalling 704 lines sat in scripts/
// untouched since May, referenced by nothing and noticed by no one.
//
// The config is almost entirely `entry`, and that is the shape of the problem
// rather than laziness. Nothing in this repo imports the things that run: the
// pipeline scripts are invoked by name from a shell script, the islands are
// globbed by the bundler and then fetched by string path at runtime, and
// shared/ is imported by a second application in another workspace. A tool that
// only follows `import` statements sees a codebase that is almost entirely
// dead. Every entry below is a real execution path; a script missing from this
// list is a script knip will call dead, so add here when you add there.
{
  "$schema": "https://unpkg.com/knip@6/schema.jsonc",

  "entry": [
    // ── The editorial cycle. Extracted from scripts/run-cycle.sh, which
    //    invokes each of these by name. Keep in sync with that file.
    //
    //    Five of them (build, fetch-news, generate-briefing, watch, test-voice)
    //    knip also finds through package.json's scripts, and it will say so as
    //    a "redundant entry pattern" hint. They stay listed: this block's job is
    //    to be a readable mirror of run-cycle.sh, and a list with holes in it
    //    wherever npm happens to agree is not one. `npm run deadcode` passes
    //    --no-config-hints so the command reports findings, not config advice.
    "scripts/backfill-selection.js",
    "scripts/build.js",
    "scripts/compute-metrics.js",
    "scripts/coverage-map.js",
    "scripts/dedup-selection.js",
    "scripts/enrich-selection.js",
    "scripts/attach-indicators.js",
    "scripts/extract-entities.js",
    "scripts/extract-source-angles.js",
    "scripts/translate-swedish.js",
    "scripts/fetch-analytics.js",
    "scripts/fetch-chokepoints.js",
    "scripts/fetch-conflict.js",
    "scripts/fetch-firms.js",
    "scripts/fetch-gdacs.js",
    "scripts/fetch-ioda.js",
    "scripts/fetch-ipc.js",
    "scripts/fetch-markets.js",
    "scripts/fetch-news-api.js",
    "scripts/fetch-news.js",
    "scripts/fetch-trends.js",
    "scripts/generate-briefing.js",
    "scripts/measure-quality.js",
    "scripts/merge-feeds.js",
    "scripts/narrate-events.js",
    "scripts/narrate-gdacs.js",
    "scripts/narrate-indicators.js",
    "scripts/pick-breaking-social.js",
    "scripts/post-to-instagram.js",
    "scripts/post-to-twitter.js",
    "scripts/prefilter-feed.js",
    "scripts/scaffold-articles.js",
    "scripts/score-production-cycle.js",
    "scripts/trending-gaps.js",
    "scripts/update-ledger.js",
    "scripts/validate-articles.js",
    "scripts/write-last-cycle.js",

    // ── npm scripts and the dashboard.
    "scripts/watch.js",
    "scripts/test-voice.js",
    "scripts/dashboard/server.js",

    // ── The autoresearch session driver, run by the /autoresearch skill.
    "scripts/autoresearch/*.js",

    // ── Stage 3.5 was removed from run-cycle.sh on 2026-06-19 (it outgrew its
    //    1200s budget as .context-briefs.json inflated each prompt), but this
    //    is not dead: scripts/autoresearch/run-replay.js:207 still runs it via
    //    spawnSync, which is a string, not an import edge. knip called it
    //    unused; it is the reason this file leads with the warning it does.
    "scripts/generate-edu-context.js",

    // ── Tests.
    "scripts/lib/*.test.js",

    // ── The measuring instruments. Run by hand against a built `dist` (or
    //    against the deployed site) rather than by anything in the repo, for
    //    the same reason shoot.mjs is: what they measure needs a real browser
    //    and, for the idle check, a real GPU and a visible window.
    "scripts/perf/*.mjs",

    // ── Manual tools. Unreferenced by design, and each one is the only way to
    //    do the thing it does: fetch-country-cards.js regenerates the committed
    //    shared/data/country-cards.json, dry-run-augment.js exercises one
    //    article through the augment prompt, shoot.mjs is the visual-regression
    //    shooter map-island.test.js points at.
    "scripts/fetch-country-cards.js",
    "scripts/dry-run-augment.js",
    "scripts/shoot.mjs",
    // generate-stars.js regenerates the committed shared/data/stars.json from
    // the Bright Star Catalogue and the IAU's name list. Committed because its
    // output is: shared/countries/country-augmented.ts names a generator that
    // is *not* in this repo, so it cannot be regenerated and 32 countries have
    // been hatched on every metric ever since.
    "scripts/generate-stars.js",
    // merge-palestine.mjs is a one-shot data edit, already applied, that
    // rewrote the bundled Natural Earth TopoJSON to carry one Palestine
    // feature. scripts/build/basemap.js does the same merge at build time with
    // its own local mergePalestine(), so this is unreferenced — and it is kept
    // because the edit it performs is a stated editorial position (see
    // "Cartography of historic Palestine" in CLAUDE.md) and the tool that
    // makes it reproducible is worth more than the eight lines it costs.
    "scripts/merge-palestine.mjs",

    // ── The browser. scripts/build/islands.js globs the non-underscore island
    //    sources as esbuild entry points, and public/island-loader.js imports
    //    the built bundles by string path at runtime — neither is an import
    //    edge any tool can follow.
    "public/islands/*.ts",
    "public/island-loader.js",

    // ── The edge.
    "functions/**/*.js",
    "workers/mcp/src/index.js",

    // ── shared/ is declared entry rather than analysed, and the trade is
    //    deliberate. It is imported by mobile/ through the `@shared/*` alias —
    //    mobile/components/globe/storyDots.ts, mobile/components/ArticlePage.tsx
    //    and others — and this workspace cannot see those edges, so an analysed
    //    shared/ would report most of types.ts, globe/coordinates.ts and
    //    countries/iso.ts as dead. They are not. Declaring it entry means knip
    //    reports nothing here at all, which is the honest of the two failures.
    //    Adding mobile as a second knip workspace is what buys real coverage
    //    back; it is a follow-up, not a prerequisite.
    "shared/**/*.ts"
  ],

  "project": [
    "scripts/**/*.{js,mjs}",
    "public/**/*.{js,ts}",
    "shared/**/*.ts",
    "functions/**/*.js",
    "workers/mcp/src/**/*.js",
    "!scripts/tmp-*",
    "!scripts/_*"
  ],

  // mobile/ has its own package.json and is out of scope here; everything else
  // knip would otherwise walk is already outside `project` above.
  "ignore": ["mobile/**"],

  // An export used inside its own file is not dead code, and reporting it as
  // such is what kept export analysis switched off for months.
  //
  // Measured: with this false the repo reports **79 unused exports**, and
  // essentially all of them are `_map/*.ts` and `scripts/lib/*.js` constants and
  // helpers that the module itself uses — `FLAT_PCT`, `marketSign`,
  // `MOVERS_PER_SIDE`, fourteen in `markets.ts` alone. They are exported because
  // this codebase treats `export` as "this is a named thing with a reason above
  // it", which is the same convention the tests rely on when they bundle a
  // module and assert against its constants. None of it is unreachable code;
  // at worst the `export` keyword is broader than it needs to be, which is a
  // different and much smaller problem than the one this tool is for.
  //
  // With it true the report is **2**, and 79 findings that are all noise is a
  // report nobody reads, which is how a real one gets missed. See "Deleting
  // code safely" in `.claude/rules/web/build.md`.
  "ignoreExportsUsedInFile": true,

  // `@knipignore` on a JSDoc comment suppresses one export, and the rule is
  // that **the comment above it must say why** — the tag records that a human
  // checked, and the sentence is what the next person needs. Two live examples,
  // and they are two different kinds of false positive:
  //
  //   · `placeDensity` (_map/places.ts) is asserted against six ways over in
  //     map-geo.test.js, but the test reaches it through the esbuild bundle
  //     `scripts/lib/island-bundle.js` builds at run time. That is not a static
  //     import edge and no tool can follow it — the same class of blindness
  //     that made knip call `generate-edu-context.js` dead.
  //   · `MARKET_CHIP_GLYPHS` (_map/markets.ts) is a `satisfies` assertion whose
  //     *value* is never meant to be read. Deleting it because nothing imports
  //     it would delete a compile-time check that the chip glyph names are keys
  //     of the glyph table.
  //
  // Both would have been "safe" deletions by the tool's own reasoning. That is
  // the argument for the protocol rather than for trusting the report.
  "tags": ["-knipignore"],

  // Resolved through a tsconfig rather than an import.
  //
  // `geojson` is the bare specifier for @types/geojson — a types-only package
  // with no runtime half, so there is no `geojson` dependency for knip to find
  // however correctly it is declared. `@shared/*` is the path alias the island
  // bundler and mobile both resolve; it is a directory in this repo, not a
  // package.
  "ignoreDependencies": ["@types/.*", "geojson", "@shared/.*"]
}
