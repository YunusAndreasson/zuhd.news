node_modules/
dist/
.cache/
.wrangler/
.env
*.log
logs/
content/audio/*.mp3
content/audio/voice-tests/
*.bad
# Claude Code config. `settings.local.json` is per-machine; `rules/` is not —
# it carries this repo's design record, scoped by `paths:` frontmatter so each
# file loads only when Claude reads code it covers. That record used to live in
# CLAUDE.md, which is tracked, and un-ignoring it here is what keeps it tracked.
/.claude/*
!/.claude/rules/
mobile/.claude/
.tmp-*
# Transient: the per-cycle social pick, regenerated (and rm'd) each cycle.
content/.breaking-pick.json

# visual-regression scratch (scripts/shoot.mjs). `.shots/` is the script's own
# default output directory and was missing here — only the suffixed variants
# were covered, so a bare `node scripts/shoot.mjs` dropped several megabytes of
# PNGs into the repo root as untracked files.
.shots/
.shots-*/
.refs/
.diag.mjs

# CSS coverage candidate list (scripts/perf/css-usage.mjs). Repo-root by
# default; re-run output, not a report anyone commits.
.css-usage*.txt
.probe.mjs

# Credential backups. `.env` was already ignored but its timestamped copies were
# not, and they hold live X, Instagram and push tokens.
.env.bak*
.env.*.bak*

# Second lockfile. The project installs with npm; a stray pnpm-lock.yaml only
# creates two sources of truth for the same dependency tree.
pnpm-lock.yaml

# One-off length/character/word counting scratch. These accumulate at the repo
# root and in scripts/ every time an article-length question comes up, under
# whatever name occurs to the session (check*, wordcheck*, count*, verify*,
# with or without underscores). Match the shape, not each name that's shown up
# so far — the exact-name list this replaced grew a line per naming variant
# and still missed the untracked ones (checkbody.js, checkwriter.py, ...).
/*check*.py
/*check*.js
/*check*.sh
/count*.py
/count*.js
/count*.sh
/verify*.py
/_tmp*.py
/_tmp*.js
/_tmp*.sh
/tmp_*.py
/tmp_*.js
/tmp_*.sh
/tmp-*.py
/tmp-*.js
/tmp-*.sh
scripts/*check*.py
scripts/*check*.js
scripts/*check*.sh
scripts/count*.py
scripts/count*.js
scripts/count*.sh
scripts/verify*.py
scripts/_tmp*.py
scripts/_tmp*.js
scripts/_tmp*.sh
scripts/tmp_*.py
scripts/tmp_*.js
scripts/tmp_*.sh
scripts/tmp-*.py
scripts/tmp-*.js
scripts/tmp-*.sh

# build.js's own concurrency guard (see scripts/build.js) — removed on exit,
# but a killed build can leave it behind.
.build.lock
